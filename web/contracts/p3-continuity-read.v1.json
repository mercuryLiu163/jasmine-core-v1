    "derived_at_identical": true,
    "derived_at_differences": []
  },
  "baseline": {
    "commit": "850fbec",
    "schema_version": 8,
    "these_routes_exist": false,
    "why": "P3 (Context/Checkpoint/Resume) is not merged into this baseline: Core here has no context/, continuity.py or task_snapshot.py, and no route for any of the four endpoints below. P6-03a is therefore delivered against this contract with the dependency marked pending."
  },
  "read_routes": [
    {
      "method": "GET",
      "path_pattern": "^/v1/context/([^/]+)$",
      "scope": "context:read",
      "handler": "get_context",
      "response_key": "context",
      "extra_scopes": [
        "objects:read",
        "state:read",
        "authority:read",
        "evidence:read",
        "events:read",
        "checkpoint:read"
      ],
      "query": []
    },
    {
      "method": "GET",
      "path_pattern": "^/v1/tasks/([^/]+)/checkpoints/latest$",
      "scope": "checkpoint:read",
      "handler": "latest_checkpoint",
      "response_key": "checkpoint",
      "extra_scopes": [
        "objects:read",
        "state:read",
        "authority:read",
        "evidence:read",
        "events:read"
      ],
      "query": [
        "session_id"
      ]
    },
    {
      "method": "GET",
      "path_pattern": "^/v1/checkpoints/([^/]+)$",
      "scope": "checkpoint:read",
      "handler": "get_checkpoint",
      "response_key": "checkpoint",
      "extra_scopes": [
        "objects:read",
        "state:read",
        "authority:read",
        "evidence:read",
        "events:read"
      ],
      "query": []
    },
    {
      "method": "GET",
      "path_pattern": "^/v1/resumes/([^/]+)$",
      "scope": "resume:read",
      "handler": "get_resume",
      "response_key": "resume",
      "extra_scopes": [
        "objects:read",
        "state:read",
        "authority:read",
        "evidence:read",
        "events:read",
        "checkpoint:read"
      ],
      "query": []
    }
  ],
  "not_in_this_slice": [
    {
      "method": "POST",
      "path_pattern": "^/v1/context/build$",
      "scope": "context:build",
      "why": "builds a pack; a write, not a read"
    },
    {
      "method": "POST",
      "path_pattern": "^/v1/context/([^/]+)/check-current$",
      "scope": "context:build",
      "why": "recomputes currency; not a read"
    },
    {
      "method": "POST",
      "path_pattern": "^/v1/checkpoints$",
      "scope": "checkpoint:write",
      "why": "creates a checkpoint"
    },
    {
      "method": "POST",
      "path_pattern": "^/v1/tasks/([^/]+)/resume$",
      "scope": "resume:build",
      "why": "builds a resume receipt"
    }
  ],
