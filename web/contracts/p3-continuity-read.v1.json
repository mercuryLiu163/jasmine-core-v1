  "semantics": {
    "checkpoint_projection_is_not_truth": "A checkpoint's `projection` is an immutable snapshot of what the Task looked like at that revision (projection_version jasmine.task-snapshot.v1), carried with `projection_digest`, `full_context_digest`, `workspace_digest` and the `task_revision` it was taken at. It is a record, never a current-state claim.",
    "latest_may_be_null": "`GET /v1/tasks/{id}/checkpoints/latest` answers 200 with `{\"checkpoint\": null}` when the Task has no checkpoint yet. That is an empty result, not an error and not an absent Task.",
    "resume_note_is_historical": "A resume carries `note` as {value, authority: false, historical: true} — the note of the checkpoint it resumed from. The view must present it as historical and non-authoritative.",
    "resume_is_a_comparison_not_a_restore": "`comparison` and `next_actions` describe how the checkpoint and the current projection differ; nothing is applied. `truth_digest` is the current Truth digest, not a restore point."
  }
}
