{
  "contract": "jasmine.p3-continuity-read.v1",
  "source": {
    "ref": "p3-checkpoint-context-resume",
    "commit": "7016dabb8926d6bd6599f1f56b8f39cbda253ebf",
    "derived_by": "scripts/p6/p3_contract.py",
